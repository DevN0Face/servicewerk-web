DJANGO_SECRET_KEY=replace-with-a-unique-production-secret

DJANGO_ALLOWED_HOSTS=servicewerk-pfalz.de,www.servicewerk-pfalz.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://servicewerk-pfalz.de,https://www.servicewerk-pfalz.de

DATABASE_URL=postgresql://servicewerk:replace-password@database:5432/servicewerk

DJANGO_ADMIN_URL=verwaltung/
DJANGO_LOG_LEVEL=INFO

# Erst nach erfolgreichem HTTPS-Test erhöhen.
DJANGO_SECURE_HSTS_SECONDS=0